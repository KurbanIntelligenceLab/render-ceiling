# Trained adapter weights — 2.6 GB, distributed out of band.
# weights/README.md records the manifest and the sha256 to verify a download against,
# and is tracked; the archive itself is not.
weights/*
!weights/README.md

# Staging area for material not referenced by the manuscript, pending deletion.
to_be_deleted/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# The manuscript itself is not published from this repository — the article is the
# journal's to distribute. manuscript/codes/ IS tracked: the figure generators are
# part of the reproducibility package and are what a reader runs.
manuscript/*
!manuscript/codes/
!manuscript/codes/**

# LaTeX build products.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc

# OS and editor
.DS_Store
.idea/
.vscode/
*.swp
